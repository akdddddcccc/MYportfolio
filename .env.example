# Sticker image provider: ofox or openai
STICKER_IMAGE_PROVIDER=ofox

# OFOX adapter (default for the livestream sticker demo)
OFOX_API_KEY=
OFOX_BASE_URL=https://api.ofox.io/v1
OFOX_IMAGE_MODEL=openai/gpt-image-2
OFOX_IMAGE_QUALITY=low
OFOX_IMAGE_USE_EDITS=1
OFOX_IMAGE_EDIT_FIELD=image
OFOX_IMAGE_EDIT_SIZE=1024x1024
OFOX_IMAGE_EDIT_FALLBACK_SIZE=
OFOX_IMAGE_EDIT_INCLUDE_EXTRAS=0
OFOX_IMAGE_ALLOW_GENERATIONS=0
OFOX_IMAGE_TIMEOUT_MS=90000

# Official OpenAI adapter (switch STICKER_IMAGE_PROVIDER to openai)
OPENAI_OFFICIAL_API_KEY=
OPENAI_OFFICIAL_BASE_URL=https://api.openai.com/v1
OPENAI_OFFICIAL_IMAGE_MODEL=gpt-image-2
OPENAI_OFFICIAL_IMAGE_QUALITY=low
OPENAI_OFFICIAL_IMAGE_USE_EDITS=1
OPENAI_OFFICIAL_IMAGE_EDIT_FIELD=image
OPENAI_OFFICIAL_IMAGE_EDIT_SIZE=
OPENAI_OFFICIAL_IMAGE_EDIT_FALLBACK_SIZE=
OPENAI_OFFICIAL_IMAGE_EDIT_INCLUDE_EXTRAS=1
OPENAI_OFFICIAL_IMAGE_TIMEOUT_MS=90000

# Text layer uses the selected sticker image provider.
OPENAI_TEXT_LAYER_SIZE=1536x1024
OPENAI_TEXT_LAYER_USE_API=1

# Task Map remains independent and defaults to DeepSeek.
TASKMAP_PROVIDER=deepseek
DEEPSEEK_TASKMAP_API_KEY=
DEEPSEEK_TASKMAP_BASE_URL=https://api.deepseek.com
DEEPSEEK_TASKMAP_MODEL=deepseek-v4-flash
TASKMAP_DEMO_FALLBACK=0
